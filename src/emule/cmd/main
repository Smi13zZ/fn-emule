#!/bin/bash
### fn-emule lifecycle: start / stop / status / restart
###
### The python panel process is the single entry point: it owns the aMule
### daemon (spawn / supervise / graceful shutdown) so the amule.conf it
### generates and the running engine never drift apart. This script therefore
### only has to look after the panel process itself.
set -u

PKG_VAR="${TRIM_PKGVAR:-/tmp/fn-emule-var}"
APP_HOME="${TRIM_APPDEST:-}"
PID_FILE="${PKG_VAR}/panel.pid"
AMULE_PID_FILE="${PKG_VAR}/amuled.pid"
LOG_FILE="${PKG_VAR}/panel.log"
PORTS_FILE="${PKG_VAR}/runtime-ports.env"
DEFAULT_PORT=17581
DEFAULT_EC_PORT=4712
APP_NAME_PKG="fn-emule"

mkdir -p "${PKG_VAR}" 2>/dev/null || true

if [ -n "${wizard_backend_port:-}" ]; then
    PORT="${wizard_backend_port}"
elif [ -n "${BACKEND_PORT:-}" ]; then
    PORT="${BACKEND_PORT}"
else
    PORT="${DEFAULT_PORT}"
fi

# eD2k ports chosen in the install wizard. The panel only consumes them when
# it creates settings.json for the very first time; afterwards the settings
# page owns them.
TCP_PORT="${wizard_tcp_port:-4662}"
UDP_PORT="${wizard_udp_port:-4672}"

SERVER="${APP_HOME}/server/emulepanel.py"

find_python() {
    local c
    for c in /usr/bin/python3 /usr/local/bin/python3 /bin/python3; do
        if [ -x "${c}" ]; then printf '%s\n' "${c}"; return 0; fi
    done
    if command -v python3 >/dev/null 2>&1; then command -v python3; return 0; fi
    return 1
}

PYTHON="$(find_python || true)"

MANIFEST_FILE="$(dirname "$0")/../manifest"
APP_VERSION=""
if [ -r "${MANIFEST_FILE}" ]; then
    APP_VERSION="$(grep -E '^version' "${MANIFEST_FILE}" | head -1 | cut -d= -f2 | tr -d ' \t\r')"
fi
[ -n "${APP_VERSION}" ] || APP_VERSION="26.11.0"

APP_ROOT_DIR="/var/apps/${APP_NAME_PKG}"
SHARE_DIR=""
if [ -e "${APP_ROOT_DIR}/shares/${APP_NAME_PKG}" ]; then
    SHARE_DIR="$(readlink -f "${APP_ROOT_DIR}/shares/${APP_NAME_PKG}" 2>/dev/null || printf '%s' "${APP_ROOT_DIR}/shares/${APP_NAME_PKG}")"
fi

warn() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
    fi
    printf '%s\n' "$1" >&2
}

read_pid() {
    [ -f "${PID_FILE}" ] && cat "${PID_FILE}" 2>/dev/null || true
}

is_running() {
    local pid
    pid="$(read_pid)"
    [ -n "${pid}" ] || return 1
    kill -0 "${pid}" 2>/dev/null
}

port_ready() {
    if (exec 3<>"/dev/tcp/127.0.0.1/${PORT}") 2>/dev/null; then
        exec 3<&- 3>&- 2>/dev/null || true
        return 0
    fi
    return 1
}

write_runtime_ports() {
    {
        printf 'BACKEND_PORT=%s\n' "${PORT}"
        printf 'ADMIN_TARGET_PORT=%s\n' "${PORT}"
        printf 'ADMIN_TARGET_HOST=127.0.0.1\n'
    } > "${PORTS_FILE}" 2>/dev/null || true
    chmod 600 "${PORTS_FILE}" 2>/dev/null || true
}

rotate_log() {
    if [ -f "${LOG_FILE}" ]; then
        local size
        size="$(wc -c < "${LOG_FILE}" 2>/dev/null || echo 0)"
        if [ "${size}" -gt 2097152 ]; then
            mv -f "${LOG_FILE}" "${LOG_FILE}.1" 2>/dev/null || true
        fi
    fi
}

start() {
    if is_running; then
        write_runtime_ports
        return 0
    fi
    if [ -z "${APP_HOME}" ]; then
        warn "TRIM_APPDEST 为空，无法定位 eMule 程序目录。"
        return 1
    fi
    if [ ! -f "${SERVER}" ]; then
        warn "找不到服务文件：${SERVER}"
        return 1
    fi
    if [ -z "${PYTHON}" ]; then
        warn "未找到 python3，eMule 面板依赖系统自带的 Python 3。"
        return 1
    fi

    mkdir -p "${PKG_VAR}/amule" "${PKG_VAR}/backups" "${PKG_VAR}/history" 2>/dev/null || true

    rotate_log
    write_runtime_ports

    cd "${APP_HOME}/server" || return 1
    TRIM_PKGVAR="${PKG_VAR}" \
    EMULE_VAR="${PKG_VAR}" \
    EMULE_APP_HOME="${APP_HOME}" \
    EMULE_APP_ROOT="${APP_ROOT_DIR}" \
    EMULE_SHARE_DIR="${SHARE_DIR}" \
    EMULE_VERSION="${APP_VERSION}" \
    EMULE_PANEL_PORT="${PORT}" \
    EMULE_DEFAULT_TCP_PORT="${TCP_PORT}" \
    EMULE_DEFAULT_UDP_PORT="${UDP_PORT}" \
    EMULE_DEFAULT_EC_PORT="${DEFAULT_EC_PORT}" \
    setsid "${PYTHON}" "${SERVER}" >> "${LOG_FILE}" 2>&1 < /dev/null &
    echo $! > "${PID_FILE}"

    local i=0
    while [ "${i}" -lt 60 ]; do
        if ! is_running; then
            warn "eMule 面板进程启动后立即退出，请查看 ${LOG_FILE}。"
            rm -f "${PID_FILE}"
            return 1
        fi
        if port_ready; then
            return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done

    warn "eMule 面板在 30 秒内未开始监听端口 ${PORT}。"
    return 1
}

# amuled is owned by the panel process, but a hard crash of the panel could
# leave it behind. Kill it explicitly so an uninstall/upgrade never inherits
# an engine holding the eD2k ports.
kill_amuled_leftover() {
    local pid=""
    [ -f "${AMULE_PID_FILE}" ] && pid="$(cat "${AMULE_PID_FILE}" 2>/dev/null || true)"
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        kill "${pid}" 2>/dev/null || true
        local i=0
        while [ "${i}" -lt 40 ] && kill -0 "${pid}" 2>/dev/null; do
            sleep 0.5
            i=$((i + 1))
        done
        kill -0 "${pid}" 2>/dev/null && kill -9 "${pid}" 2>/dev/null || true
    fi
    rm -f "${AMULE_PID_FILE}" 2>/dev/null || true
    pkill -f "${APP_HOME}/runtime/usr/bin/amuled" 2>/dev/null || true
}

stop() {
    local pid
    pid="$(read_pid)"
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        kill "${pid}" 2>/dev/null || true
        local i=0
        while [ "${i}" -lt 40 ] && kill -0 "${pid}" 2>/dev/null; do
            sleep 0.5
            i=$((i + 1))
        done
        if kill -0 "${pid}" 2>/dev/null; then
            kill -9 "${pid}" 2>/dev/null || true
        fi
    fi
    rm -f "${PID_FILE}" 2>/dev/null || true
    kill_amuled_leftover
    return 0
}

status() {
    if is_running; then return 0; fi
    if port_ready; then return 0; fi
    return 3
}

rc=0
case "${1:-}" in
    start)   start  || rc=$? ;;
    stop)    stop   || rc=$? ;;
    status)  status || rc=$? ;;
    restart) stop || true; sleep 1; start || rc=$? ;;
    *) echo "usage: $0 {start|stop|status|restart}"; rc=1 ;;
esac

exit "${rc}"
