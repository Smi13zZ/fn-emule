#!/bin/bash
### 设置变更后：重启面板让新端口生效
set -u
MAIN_SCRIPT="$(dirname "$0")/main"
[ -x "${MAIN_SCRIPT}" ] || chmod +x "${MAIN_SCRIPT}" 2>/dev/null || true
[ -x "${MAIN_SCRIPT}" ] || exit 0
if "${MAIN_SCRIPT}" status >/dev/null 2>&1; then
    if ! "${MAIN_SCRIPT}" stop; then
        echo "eMule 面板停止失败，端口变更未生效。" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
        exit 1
    fi
    sleep 1
    if ! "${MAIN_SCRIPT}" start; then
        echo "eMule 面板使用新端口启动失败，请检查端口是否被占用。" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
        exit 1
    fi
fi
exit 0
